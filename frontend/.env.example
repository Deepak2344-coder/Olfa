# Copy to .env (one level up, .env is gitignored). Never commit real .env.

# true = serve the /shared/contracts examples as canned scans (1.5s fake delay)
# false/empty = POST to the real backend
VITE_USE_MOCK=true

# Backend API base URL (root .env.example uses VITE_API_BASE_URL; both are read)
VITE_API_URL=http://127.0.0.1:8000
