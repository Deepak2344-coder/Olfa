# Copy to .env and fill in real values. Never commit .env.

# Backend
HOST=127.0.0.1
PORT=8000
# Comma separated list of origins allowed to call the API (the dashboard during dev)
CORS_ORIGINS=http://localhost:5173
# Shared secret for the API, if you enable one
API_KEY=

# Engine providers (optional, engines degrade gracefully when empty)
BROWSERSAFE_API_KEY=
VIRUSTOTAL_API_KEY=
OPENSUBDOMAINS_API_KEY=

# Storage
DATABASE_URL=sqlite:///./data.db

# Frontend / extension
VITE_API_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
